# Spring profile
SPRING_PROFILES_ACTIVE=dev
PORT=8081

# MongoDB nghiệp vụ
MONGODB_URI=mongodb://localhost:27017/cv

# PostgreSQL analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=cv

# JWT - dùng cùng secret với NestJS khi cần tương thích token
JWT_ACCESS_TOKEN_SECRET=change-me-access-secret-change-me-access-secret
JWT_REFRESH_TOKEN_SECRET=change-me-refresh-secret-change-me-refresh-secret
JWT_ACCESS_EXPIRE_MS=900000
JWT_REFRESH_EXPIRE_MS=604800000

# Khởi tạo role/user mặc định
SHOULD_INIT=false
INIT_PASSWORD=123456

# SMTP hoặc MailHog local
MAIL_HOST=localhost
MAIL_PORT=1025
SENDER_EMAIL=
PASSWORD_EMAIL=
